---
import SiteFooter from "@frondruntime/site-kit/components/SiteFooter.astro";
import SiteHeader from "@frondruntime/site-kit/components/SiteHeader.astro";
import BaseLayout from "@frondruntime/site-kit/layouts/BaseLayout.astro";
import { docsPath } from "@frondruntime/site-kit/sidebar";
import Brand from "../components/Brand.astro";
import { footer, headerLinks, site } from "../site";
import "@frondruntime/site-kit/styles/page.css";
---

<BaseLayout site={site} title={`404 — ${site.name}`} description="Nothing here." indexable={false} bodyClass="short-page">
  <SiteHeader brand={Brand} links={headerLinks} />
  <main class="page-main notfound-main">
    <div class="page-shell">
      <p class="page-eyebrow notfound-eyebrow">Not found</p>
      <h1 class="page-title notfound-title"><span>Nothing here</span></h1>
      <div class="page-actions">
        <a class="action page-action-primary" href="/">Back to home</a>
        <a class="action btn-secondary" href={docsPath("start")}>Read the docs</a>
      </div>
    </div>
  </main>
  <SiteFooter {...footer} />
</BaseLayout>
