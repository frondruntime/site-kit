{
  "name": "@frondruntime/site-kit",
  "version": "0.1.0",
  "private": true,
  "description": "The components, stylesheets, Markdown plugins, and helpers the Frond and Pinna sites share, as Astro source.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "astro-component",
    "withastro"
  ],
  "workspaces": [
    "fixture"
  ],
  "exports": {
    "./types": "./src/types.ts",
    "./collection": "./src/lib/collection.ts",
    "./sidebar": "./src/lib/sidebar.ts",
    "./metadata": "./src/lib/siteMetadata.ts",
    "./llms": "./src/lib/llms.ts",
    "./sync": "./src/lib/sync.ts",
    "./regions": "./src/lib/regions.ts",
    "./sample-imports": "./src/lib/sampleImports.ts",
    "./palette": "./src/lib/palette.ts",
    "./code-theme": "./src/lib/codeTheme.ts",
    "./fonts": "./src/lib/fonts.ts",
    "./analytics": "./src/lib/analytics.ts",
    "./plugins": "./src/plugins/index.ts",
    "./layouts/*": "./src/layouts/*",
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format . --write",
    "test": "bun test ./test",
    "fixture": "bun run --cwd fixture build",
    "typecheck": "astro check && tsc --noEmit -p test/tsconfig.json",
    "check": "bun run lint && bun run test && bun run fixture && bun run typecheck"
  },
  "peerDependencies": {
    "astro": "7.4.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.4",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "beautiful-mermaid": "1.1.3",
    "unist-util-visit": "5.2.0",
    "vfile": "6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.4.8",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "astro": "7.4.2",
    "typescript": "6.0.3"
  }
}
